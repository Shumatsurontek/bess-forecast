# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=bess_forecast
POSTGRES_USER=bess
POSTGRES_PASSWORD=bess_password
DATABASE_URL=postgresql+psycopg://bess:bess_password@localhost:5433/bess_forecast

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- OpenAI (diagnostic agent) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=ls_...
LANGCHAIN_PROJECT=bess-forecast
LANGSMITH_PROJECT=bess-forecast
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Pipeline defaults ---
SITE_NAME=default
ASSET_NAME=meter-01
ASSET_MAX_KW=200.0
QUANTILE=0.75
HORIZON_QUARTERS=96
